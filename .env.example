# PostgreSQL (Neon). Paste the connection string as provided by Neon.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-long-random-secret
ADMIN_TOKEN=replace-with-another-long-random-secret

# Optional: Kinopoisk API catalog enrichment. Apple/iTunes source works without this key.
KP_API_KEY=

# Optional VK ID OAuth 2.1 + PKCE. Leave empty to keep guest-only sign-in.
# Redirect URI must exactly match the app settings in VK ID.
# Local: https://your-domain.example/api/auth/vk/callback
# Development: http://localhost:8000/api/auth/vk/callback
VK_CLIENT_ID=
VK_REDIRECT_URI=
# Only needed for certain confidential VK ID app configurations.
VK_SERVICE_TOKEN=
